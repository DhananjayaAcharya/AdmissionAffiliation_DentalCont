@{
}
@model FacultyIntakeViewModel
@inject Microsoft.AspNetCore.Http.IHttpContextAccessor HttpContextAccessor
@{
    Layout = null;
    ViewData["Title"] = "Course Intake Details";
    var courseLevels = ViewBag.CourseLevels as List<string> ?? new List<string>();
    var repositoryRows = ViewBag.RepositoryRows as List<UgandPgrepository> ?? new List<UgandPgrepository>();
    var freshIncreaseOptions = ViewBag.FreshIncreaseOptions as string[] ?? new[] { "Fresh", "Increase" };
    var facultyCode = HttpContextAccessor.HttpContext.Session.GetString("FacultyCode");
    Context.Response.Headers["Cache-Control"] = "no-cache, no-store, must-revalidate";
    Context.Response.Headers["Pragma"] = "no-cache";
    Context.Response.Headers["Expires"] = "0";
    int currentStep = 2;
    var isSidebarVisible = !string.IsNullOrEmpty(facultyCode);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] — RGUHS Portal</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@600;700&family=DM+Sans:wght@300;400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation@1.20.0/dist/jquery.validate.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/jquery-validation-unobtrusive@4.0.0/dist/jquery.validate.unobtrusive.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <style>
        :root {
            --navy: #0d1b3e;
            --navy-mid: #1a2f5f;
            --blue: #1d4ed8;
            --blue-light: #3b82f6;
            --gold: #c8a84b;
            --gold-pale: #f7f0dc;
            --surface: #f4f6fb;
            --card-bg: #ffffff;
            --border: #dde3f0;
            --text-main: #0d1b3e;
            --text-muted: #6b7a99;
            --danger: #dc2626;
            --success: #16a34a;
            --warn: #d97706;
            --radius: 14px;
            --shadow-sm: 0 2px 8px rgba(13,27,62,.07);
            --shadow-md: 0 6px 24px rgba(13,27,62,.10);
        }

        *, *::before, *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'DM Sans', sans-serif;
            background: var(--surface);
            color: var(--text-main);
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        /* HEADER */
        .portal-header {
            background: var(--navy);
            color: #fff;
            padding: 0 2rem;
            height: 64px;
            display: flex;
            align-items: center;
            justify-content: space-between;
            position: sticky;
            top: 0;
            z-index: 1000;
            box-shadow: 0 2px 12px rgba(0,0,0,.25);
            border-bottom: 2px solid var(--gold);
        }

            .portal-header .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
            }

            .portal-header .brand-emblem {
                width: 38px;
                height: 38px;
                background: var(--gold);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 1.1rem;
                color: var(--navy);
                font-weight: 700;
            }

            .portal-header .brand-title {
                font-family: 'Playfair Display', serif;
                font-size: 1rem;
                font-weight: 700;
                color: #fff;
                letter-spacing: .3px;
            }

            .portal-header .brand-sub {
                font-size: .7rem;
                color: rgba(255,255,255,.6);
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .portal-header .header-meta {
                font-size: .78rem;
                color: rgba(255,255,255,.7);
                display: flex;
                align-items: center;
                gap: 18px;
            }

                .portal-header .header-meta span {
                    display: flex;
                    align-items: center;
                    gap: 5px;
                }

        /* LAYOUT */
        .page-shell {
            display: flex;
            flex: 1;
        }

        .content-area {
            flex: 1;
            padding: 1.5rem 2.5rem;
            max-width: 1440px;
            margin: 0 auto;
            width: 100%;
        }

        /* PAGE TITLE */
        .page-title-block {
            display: flex;
            align-items: flex-end;
            justify-content: space-between;
            margin-bottom: 0.05rem;
            padding-bottom: 1.25rem;
            border-bottom: 1px solid var(--border);
        }

            .page-title-block h1 {
                font-family: 'Playfair Display', serif;
                font-size: 1.7rem;
                font-weight: 700;
                color: var(--navy);
                line-height: 1.2;
                text-align: center;s
            }

            .page-title-block .page-crumb {
                font-size: .78rem;
                color: var(--text-muted);
                margin-top: 4px;
                display: flex;
                align-items: center;
                gap: 6px;
            }

                .page-title-block .page-crumb i {
                    color: var(--gold);
                }

        /* STEPPER */
        .stepper-card {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: var(--radius);
            padding: 1rem 1.5rem .5rem;
            margin-bottom: 1.75rem;
            box-shadow: var(--shadow-sm);
        }

        .stepper-label {
            font-size: .68rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 1.5px;
            color: var(--text-muted);
            margin-bottom: .75rem;
            text-align: center;
        }

        .stepper {
            display: flex;
            align-items: flex-start;
            gap: 0;
            overflow-x: auto;
            scrollbar-width: none;
            padding-bottom: 4px;
        }

            .stepper::-webkit-scrollbar {
                display: none;
            }

        .step-item {
            display: flex;
            flex-direction: column;
            align-items: center;
            flex: 1;
            min-width: 0;
            position: relative;
        }

            .step-item:not(:last-child)::after {
                content: '';
                position: absolute;
                top: 14px;
                left: 50%;
                width: 100%;
                height: 2px;
                background: var(--border);
                z-index: 0;
                transition: background .4s;
            }

            .step-item.completed:not(:last-child)::after {
                background: var(--success);
            }

        .step-dot {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            border: 2px solid var(--border);
            background: var(--card-bg);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: .7rem;
            font-weight: 700;
            color: var(--text-muted);
            position: relative;
            z-index: 1;
            transition: all .3s;
            flex-shrink: 0;
        }

        .step-item.active .step-dot {
            border-color: var(--blue);
            background: var(--blue);
            color: #fff;
            box-shadow: 0 0 0 4px rgba(29,78,216,.15);
        }

        .step-item.completed .step-dot {
            border-color: var(--success);
            background: var(--success);
            color: #fff;
        }

        .step-title {
            font-size: .65rem;
            font-weight: 500;
            color: var(--text-muted);
            text-align: center;
            margin-top: 6px;
            line-height: 1.3;
            max-width: 88px;
            word-break: break-word;
        }

        .step-item.active .step-title {
            color: var(--blue);
            font-weight: 600;
        }

        .step-item.completed .step-title {
            color: var(--success);
        }

        /* GRID */
        .main-grid {
            display: grid;
            grid-template-columns: 400px 1fr;
            gap: 1.5rem;
            align-items: start;
        }

        /* PANEL */
        .panel {
            background: var(--card-bg);
            border: 1px solid var(--border);
            border-radius: 14px; /* softer rounded */
            box-shadow: 0 6px 18px rgba(0,0,0,0.08); /* smoother shadow */
            overflow: hidden;
            margin-bottom: 1.5rem; /* spacing between panels */
        }


        /* ================= HEADER ================= */

        .panel-header {
            padding: 1.2rem 1.5rem; /* increased padding */
            background: var(--navy);
            display: flex;
            align-items: center;
            justify-content: center; /* better spacing */
            gap: 12px;
        }

        .panel-header h5 {
            font-family: 'Playfair Display', serif;
            font-size: 1.1rem; /* slightly bigger */
            font-weight: 700;
            color: #fff;
            margin: 0;
            letter-spacing: 0.3px;
        }

        .panel-header i {
            color: var(--gold);
            font-size: 1.2rem; /* slightly bigger icon */
        }


        /* ================= BODY ================= */

        .panel-body {
            padding: 1.75rem; /* more breathing space */
        }


        /* ================= TABLE IMPROVEMENT ================= */

        .table-scroll-wrap {
            padding: 1rem 1.5rem; /* add spacing around table */
        }

        .data-table {
            width: 100%;
            border-collapse: separate;
            border-spacing: 0 10px; /* row gap effect */
        }

        .data-table th {
            padding: 12px 10px;
            font-size: 0.85rem;
            color: var(--text-muted);
            text-align: left;
        }

        .data-table td {
            padding: 14px 10px; /* increased row height */
            background: #fff;
            border-top: 1px solid var(--border);
            border-bottom: 1px solid var(--border);
        }


        /* ================= ACTION BUTTON SPACING ================= */

        .action-cell {
            display: flex;
            flex-direction: column;
            gap: 8px; /* spacing between buttons */
        }

        .action-row-btns {
            display: flex;
            gap: 8px;
        }


        /* ================= EMPTY STATE ================= */

        .empty-state {
            padding: 2rem;
            text-align: center;
            color: var(--text-muted);
        }

        .empty-state i {
            font-size: 2rem;
            margin-bottom: 10px;
        }

        /* FORM */
        .form-label {
            font-size: .78rem;
            font-weight: 600;
            letter-spacing: .3px;
            color: var(--text-muted);
            text-transform: uppercase;
            margin-bottom: .4rem;
        }

        .form-control, .form-select {
            font-family: 'DM Sans', sans-serif;
            font-size: .875rem;
            border: 1.5px solid var(--border);
            border-radius: 8px;
            padding: .55rem .85rem;
            color: var(--text-main);
            background: #fafbfd;
            transition: border-color .2s, box-shadow .2s;
        }

            .form-control:focus, .form-select:focus {
                border-color: var(--blue);
                box-shadow: 0 0 0 3px rgba(29,78,216,.1);
                background: #fff;
                outline: none;
            }

            .form-control::placeholder {
                color: #b0b9cc;
            }

        /* SECTION DIVIDER */
        .section-divider {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 1.25rem 0 1rem;
        }

            .section-divider span {
                font-size: .7rem;
                font-weight: 700;
                letter-spacing: 1.5px;
                text-transform: uppercase;
                color: var(--text-muted);
                white-space: nowrap;
            }

            .section-divider::before, .section-divider::after {
                content: '';
                flex: 1;
                height: 1px;
                background: var(--border);
            }

        /* FILE UPLOAD */
        .upload-grid {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: .75rem;
        }

        .upload-field-label {
            font-size: .72rem;
            font-weight: 600;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: .4px;
            margin-bottom: .35rem;
        }

        .upload-box {
            border: 1.5px dashed var(--border);
            border-radius: 10px;
            padding: .65rem .85rem;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            cursor: pointer;
            transition: border-color .2s, background .2s;
            background: #fafbfd;
        }

            .upload-box:hover {
                border-color: var(--blue-light);
                background: #eff4ff;
            }

            .upload-box i {
                font-size: 1.3rem;
                color: var(--blue-light);
            }

            .upload-box .upload-label-txt {
                font-size: .72rem;
                color: var(--text-muted);
                text-align: center;
            }

            .upload-box .file-name {
                font-size: .68rem;
                font-style: italic;
                color: var(--text-muted);
                word-break: break-all;
                text-align: center;
            }

                .upload-box .file-name.file-selected {
                    color: var(--blue);
                    font-style: normal;
                }

        .hidden-file-input {
            display: none !important;
        }

        /* BUTTONS */
        .btn-official {
            background: var(--navy);
            color: #fff;
            border: none;
            border-radius: 8px;
            padding: .65rem 1.4rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .875rem;
            font-weight: 600;
            letter-spacing: .3px;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 8px;
            transition: background .2s, transform .15s, box-shadow .2s;
        }

            .btn-official:hover {
                background: var(--blue);
                box-shadow: 0 4px 16px rgba(29,78,216,.25);
                transform: translateY(-1px);
                color: #fff;
            }

        .btn-official-outline {
            background: transparent;
            color: var(--navy);
            border: 1.5px solid var(--navy);
            border-radius: 8px;
            padding: .55rem 1.1rem;
            font-family: 'DM Sans', sans-serif;
            font-size: .82rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            transition: all .2s;
            text-decoration: none;
        }

            .btn-official-outline:hover {
                background: var(--navy);
                color: #fff;
            }

        /* ALERTS */
        .alert-custom {
            border-radius: 8px;
            padding: .65rem 1rem;
            font-size: .82rem;
            font-weight: 500;
            display: flex;
            align-items: center;
            gap: 8px;
            margin-bottom: 1rem;
        }

            .alert-custom.danger {
                background: #fef2f2;
                color: var(--danger);
                border: 1px solid #fecaca;
            }

            .alert-custom.success {
                background: #f0fdf4;
                color: var(--success);
                border: 1px solid #bbf7d0;
            }

        /* TABLE */
        .table-panel-header {
            padding: 1rem 1.25rem;
            border-bottom: 1px solid var(--border);
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .table-panel-header h5 {
                font-family: 'Playfair Display', serif;
                font-size: 1rem;
                font-weight: 700;
                color: var(--navy);
                margin: 0;
            }

            .table-panel-header .record-count {
                background: var(--navy);
                color: #fff;
                font-size: .7rem;
                font-weight: 700;
                padding: 3px 10px;
                border-radius: 20px;
            }

        .table-scroll-wrap {
            overflow-x: auto;
            max-height: 560px;
            overflow-y: auto;
        }

        .data-table {
            width: 100%;
            border-collapse: collapse;
            font-size: .8rem;
        }

            .data-table thead th {
                background: var(--surface);
                color: var(--text-muted);
                font-weight: 700;
                font-size: .67rem;
                text-transform: uppercase;
                letter-spacing: .8px;
                padding: .7rem 1rem;
                border-bottom: 2px solid var(--border);
                white-space: nowrap;
                position: sticky;
                top: 0;
                z-index: 2;
            }

            .data-table tbody td {
                padding: .65rem .85rem;
                border-bottom: 1px solid var(--border);
                color: var(--text-main);
                vertical-align: middle;
            }

            .data-table tbody tr:last-child td {
                border-bottom: none;
            }

            .data-table tbody tr:hover td {
                background: #f4f7ff;
            }

            /* Edit mode row highlight */
            .data-table tbody tr.editing-row td {
                background: #fffbeb !important;
            }

            .data-table tbody tr.editing-row {
                outline: 2px solid var(--gold);
                outline-offset: -1px;
            }

        /* Inline edit inputs */
        .edit-input {
            font-size: .78rem;
            border: 1.5px solid var(--blue-light);
            border-radius: 6px;
            padding: .3rem .5rem;
            background: #fff;
            color: var(--text-main);
            width: 100%;
            min-width: 60px;
            font-family: 'DM Sans', sans-serif;
        }

            .edit-input:focus {
                outline: none;
                border-color: var(--blue);
                box-shadow: 0 0 0 2px rgba(29,78,216,.12);
            }

        .edit-select {
            font-size: .78rem;
            border: 1.5px solid var(--blue-light);
            border-radius: 6px;
            padding: .3rem .5rem;
            background: #fff;
            color: var(--text-main);
            font-family: 'DM Sans', sans-serif;
            width: 100%;
        }

        /* Inline file upload in edit mode */
        .inline-upload-label {
            display: inline-flex;
            align-items: center;
            gap: 4px;
            font-size: .68rem;
            font-weight: 600;
            color: var(--blue);
            background: #eff4ff;
            border: 1px solid #c7d7fd;
            border-radius: 6px;
            padding: 3px 8px;
            cursor: pointer;
            transition: all .18s;
            white-space: nowrap;
        }

            .inline-upload-label:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
            }

        .inline-file-name {
            display: block;
            font-size: .62rem;
            color: var(--text-muted);
            margin-top: 2px;
            font-style: italic;
            max-width: 90px;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
        }

            .inline-file-name.chosen {
                color: var(--blue);
                font-style: normal;
            }

        /* View / doc buttons */
        .doc-btn {
            background: #eff4ff;
            color: var(--blue);
            border: 1px solid #c7d7fd;
            border-radius: 6px;
            padding: 3px 10px;
            font-size: .68rem;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all .18s;
        }

            .doc-btn:hover {
                background: var(--blue);
                color: #fff;
                border-color: var(--blue);
            }

        .doc-btn-missing {
            color: #c0c8db;
            font-size: .7rem;
        }

        /* Action buttons in table */
        .btn-edit {
            background: #fffbeb;
            color: var(--warn);
            border: 1px solid #fde68a;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: .7rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all .18s;
        }

            .btn-edit:hover {
                background: var(--warn);
                color: #fff;
                border-color: var(--warn);
            }

        .btn-save-row {
            background: #f0fdf4;
            color: var(--success);
            border: 1px solid #bbf7d0;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: .7rem;
            font-weight: 600;
            cursor: pointer;
            display: none;
            align-items: center;
            gap: 4px;
            transition: all .18s;
        }

            .btn-save-row:hover {
                background: var(--success);
                color: #fff;
                border-color: var(--success);
            }

        .btn-cancel-row {
            background: #f8fafc;
            color: var(--text-muted);
            border: 1px solid var(--border);
            border-radius: 6px;
            padding: 4px 10px;
            font-size: .7rem;
            font-weight: 600;
            cursor: pointer;
            display: none;
            align-items: center;
            gap: 4px;
            transition: all .18s;
            margin-top: 4px;
        }

            .btn-cancel-row:hover {
                background: var(--text-muted);
                color: #fff;
            }

        .btn-delete {
            background: #fef2f2;
            color: var(--danger);
            border: 1px solid #fecaca;
            border-radius: 6px;
            padding: 4px 10px;
            font-size: .7rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 4px;
            transition: all .18s;
        }

            .btn-delete:hover {
                background: var(--danger);
                color: #fff;
                border-color: var(--danger);
            }

        /* Action cell layout */
        .action-cell {
            display: flex;
            flex-direction: row;
            gap: 4px;
            min-width: 90px;
        }

        .action-row-btns {
            display: flex;
            gap: 4px;
            flex-wrap: wrap;
        }

        /* Badges */
        .badge-fresh {
            background: #dcfce7;
            color: #15803d;
            font-size: .65rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            letter-spacing: .4px;
            text-transform: uppercase;
        }

        .badge-increase {
            background: #fef3c7;
            color: #92400e;
            font-size: .65rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            letter-spacing: .4px;
            text-transform: uppercase;
        }

        .badge-additional {
            background: #ede9fe;
            color: #5b21b6;
            font-size: .65rem;
            font-weight: 700;
            padding: 3px 8px;
            border-radius: 20px;
            letter-spacing: .4px;
            text-transform: uppercase;
        }

        /* Nav footer */
        .nav-footer {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-top: 1.75rem;
            padding-top: 1.25rem;
            border-top: 1px solid var(--border);
        }

        /* Empty state */
        .empty-state {
            padding: 2.5rem;
            text-align: center;
            color: var(--text-muted);
        }

            .empty-state i {
                font-size: 2rem;
                margin-bottom: .5rem;
                display: block;
            }

            .empty-state p {
                font-size: .82rem;
            }

        /* Saving spinner overlay on row */
        .row-saving {
            opacity: .6;
            pointer-events: none;
        }

        @@media (max-width: 1100px) {
            .main-grid {
                grid-template-columns: 1fr;
            }

            .content-area {
                padding: 1.5rem 1.25rem;
            }
        }

        @@media (max-width: 600px) {
            .upload-grid {
                grid-template-columns: 1fr;
            }

            .portal-header .header-meta {
                display: none;
            }
        }

        ::-webkit-scrollbar {
            width: 6px;
            height: 6px;
        }

        ::-webkit-scrollbar-track {
            background: var(--surface);
        }

        ::-webkit-scrollbar-thumb {
            background: #c0c8db;
            border-radius: 3px;
        }

        /* SweetAlert2 custom overrides */
        .swal-custom-popup {
            font-family: 'DM Sans', sans-serif !important;
            border-radius: 16px !important;
        }

        .swal-custom-title {
            font-family: 'Playfair Display', serif !important;
            font-size: 1.15rem !important;
            color: #0d1b3e !important;
        }

        .swal-confirm-btn,
        .swal-cancel-btn {
            font-family: 'DM Sans', sans-serif !important;
            font-weight: 600 !important;
            border-radius: 8px !important;
            padding: .55rem 1.3rem !important;
        }
    </style>
</head>
<body>

    <!-- HEADER -->
    <header class="portal-header">
        <a href="#" class="brand" style="text-decoration:none;">
            <div class="brand-emblem"><i class="bi bi-mortarboard-fill"></i></div>
            <div>
                <div class="brand-title">RGUHS Affiliation Portal</div>
                <div class="brand-sub">Rajiv Gandhi University of Health Sciences</div>
            </div>
        </a>
        <div class="header-meta">
            @using System.Text.RegularExpressions
            @{
                var collegeFullName = HttpContextAccessor.HttpContext.Session.GetString("CollegeName") ?? "";
                var collegeName = Regex.Replace(collegeFullName, @"[\s\-:]*[A-Za-z]*\d{3,}\s*$", "").Trim();
            }
            @if (!string.IsNullOrEmpty(collegeName))
            {
                <span><i class="bi bi-building"></i> @collegeName</span>
            }
            <span><i class="bi bi-calendar3"></i> @DateTime.Now.ToString("dd MMM yyyy")</span>
        </div>
    </header>

    <div class="page-shell">
        <main class="content-area">

            <!-- Page Title -->
            <div class="page-title-block">
                <div style="width: 100%">
                    <h1>UG / PG Intake Details</h1>
                    @* <div class="page-crumb">
                        <i class="bi bi-house-fill"></i> Home
                        <i class="bi bi-chevron-right" style="font-size:.65rem;"></i> Admission Affiliation
                        <i class="bi bi-chevron-right" style="font-size:.65rem;"></i>
                        <strong>Course Intake</strong>
                    </div> *@
                    <div class="page-crumb">
    
                        <!-- Home -->
                        <a asp-controller="Collegelogin" asp-action="Dashboard" class="crumb-link">
                            <i class="bi bi-house-fill"></i> Home
                        </a>

                        <i class="bi bi-chevron-right crumb-separator"></i>

                        <!-- College Details -->
                        <a asp-controller="Repo" asp-action="Repo_BasicDetails" class="crumb-link">
                            College Details
                        </a>

                        <i class="bi bi-chevron-right crumb-separator"></i>

                        <!-- Current Page -->
                        <strong>Course Intake</strong>

                    </div>
                </div>
                @* <span style="font-size:.72rem;color:var(--text-muted);background:var(--surface);border:1px solid var(--border);border-radius:20px;padding:4px 12px;">
                    <i class="bi bi-shield-lock" style="color:var(--gold);"></i> Secure Session
                </span> *@
            </div>

            <!-- STEPPER -->
            @{
                var stepTitles = new[] {
                        "Institute Basic Details",
                        "Course Details",
                        // "Hospital Details",
                        // "Required Faculty Details",
                        // "Add College Faculty details",
                        // "Academic Performance"
                        };
            }
            <div class="stepper-card">
                <div class="stepper-label">Application Progress — Step @currentStep of @stepTitles.Length</div>
                <div class="stepper">
                    @for (int i = 0; i < stepTitles.Length; i++)
                    {
                        var isActive = (currentStep == i + 1);
                        var isCompleted = (currentStep > i + 1);
                        var cls = isActive ? "active" : (isCompleted ? "completed" : "");
                        <div class="step-item @cls">
                            <div class="step-dot">
                                @if (isCompleted)
                                {
                                    <i class="bi bi-check-lg" style="font-size:.75rem;"></i>
                                }
                                else
                                {

                                    @(i + 1)
                                }
                            </div>
                            <span class="step-title">@stepTitles[i]</span>
                        </div>
                    }
                </div>
            </div>

            <!-- MAIN GRID -->
            <div class="main-grid">

                <!-- LEFT: ADD FORM -->
                <div class="panel">
                    <div class="panel-header">
                        <i class="bi bi-journal-plus"></i>
                        <h5>Faculty Intake Form</h5>
                    </div>
                    <div class="panel-body">

                        @if (TempData["ErrorMessage"] != null)
                        {
                            <div class="alert-custom danger">
                                <i class="bi bi-exclamation-triangle-fill"></i> @TempData["ErrorMessage"]
                            </div>
                        }
                        @if (TempData["SuccessMessage"] != null)
                        {
                            <div class="alert-custom success">
                                <i class="bi bi-check-circle-fill"></i> @TempData["SuccessMessage"]
                            </div>
                        }

                        <form asp-action="Repo_UGPG" method="post" enctype="multipart/form-data" autocomplete="off">
                            @Html.AntiForgeryToken()

                            <div class="mb-3">
                                <label for="CourseLevel" class="form-label">Course Level</label>
                                <select id="CourseLevel" name="CourseLevel" asp-for="CourseLevel" class="form-select">
                                    <option value="">— Select Level —</option>
                                    @foreach (var lvl in courseLevels)
                                    {
                                        <option value="@lvl" @(Model.CourseLevel == lvl ? "selected" : "")>@lvl</option>
                                    }
                                </select>
                                <span asp-validation-for="CourseLevel" class="text-danger" style="font-size:.75rem;"></span>
                            </div>

                            <div class="mb-3">
                                <label for="CourseDropdown" class="form-label">Course</label>
                                <select asp-for="CourseCode" class="form-select" id="CourseDropdown" name="CourseCode">
                                    <option value="">— Select Level First —</option>
                                </select>
                                <span asp-validation-for="CourseCode" class="text-danger" style="font-size:.75rem;"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="FreshOrIncrease" class="form-label">Fresh / Increase / Additional</label>
                                <select asp-for="FreshOrIncrease" class="form-select" id="FreshOrIncrease" name="FreshOrIncrease">
                                    <option value="">— Select —</option>
                                    @foreach (var option in freshIncreaseOptions)
                                    {
                                        <option value="@option" @(Model.FreshOrIncrease == option ? "selected" : "")>@option</option>
                                    }
                                </select>
                                <span asp-validation-for="FreshOrIncrease" class="text-danger" style="font-size:.75rem;"></span>
                            </div>

                            <div class="mb-3">
                                <label asp-for="IntakeDetails" class="form-label">Intake Details</label>
                                <input asp-for="IntakeDetails" class="form-control" placeholder="e.g. 60" />
                                <span asp-validation-for="IntakeDetails" class="text-danger" style="font-size:.75rem;"></span>
                            </div>

                            <div class="section-divider">
                                <i class="bi bi-paperclip" style="color:var(--gold);font-size:.85rem;"></i>
                                <span>Supporting Documents</span>
                            </div>

                            <div class="upload-grid">
                                <!-- RGUHS -->
                                <div>
                                    <div class="upload-field-label">RGUHS Notification</div>
                                    <div class="upload-box" onclick="this.querySelector('.hidden-file-input').click()">
                                        <i class="bi bi-cloud-upload"></i>
                                        <span class="upload-label-txt">Click to upload</span>
                                        <span class="file-name file-not-selected">No file chosen</span>
                                        <input type="file" asp-for="RGUHSNotificationFile" class="hidden-file-input" />
                                    </div>
                                </div>
                                <!-- DCI (was INC) -->
                                <div>
                                    <div class="upload-field-label">DCI Upload</div>
                                    <div class="upload-box" onclick="this.querySelector('.hidden-file-input').click()">
                                        <i class="bi bi-cloud-upload"></i>
                                        <span class="upload-label-txt">Click to upload</span>
                                        <span class="file-name file-not-selected">No file chosen</span>
                                        <input type="file" asp-for="INCUploadFile" class="hidden-file-input" />
                                    </div>
                                </div>
                                <!-- KSDC (was KNMC) -->
                                <div>
                                    <div class="upload-field-label">KSDC Upload</div>
                                    <div class="upload-box" onclick="this.querySelector('.hidden-file-input').click()">
                                        <i class="bi bi-cloud-upload"></i>
                                        <span class="upload-label-txt">Click to upload</span>
                                        <span class="file-name file-not-selected">No file chosen</span>
                                        <input type="file" asp-for="KNMCUploadFile" class="hidden-file-input" />
                                    </div>
                                </div>
                                <!-- GOK -->
                                <div>
                                    <div class="upload-field-label">GOK Upload</div>
                                    <div class="upload-box" onclick="this.querySelector('.hidden-file-input').click()">
                                        <i class="bi bi-cloud-upload"></i>
                                        <span class="upload-label-txt">Click to upload</span>
                                        <span class="file-name file-not-selected">No file chosen</span>
                                        <input type="file" asp-for="GOKUploadFile" class="hidden-file-input" />
                                    </div>
                                </div>
                            </div>

                            <button type="submit" class="btn-official w-100 mt-4" style="justify-content:center;">
                                <i class="bi bi-save2"></i> Save Intake Record
                            </button>
                        </form>
                    </div>
                </div>

                <!-- RIGHT: TABLE -->
                <div class="panel">
                    <div class="table-panel-header">
                        <h5><i class="bi bi-table" style="color:var(--gold);margin-right:6px;"></i> Recent Uploads</h5>
                        <span class="record-count">@repositoryRows.Count Records</span>
                    </div>
                    <div class="table-scroll-wrap">
                        @if (!repositoryRows.Any())
                        {
                            <div class="empty-state">
                                <i class="bi bi-inbox"></i>
                                <p>No intake records submitted yet.<br />Fill the form on the left to add your first entry.</p>
                            </div>
                        }
                        else
                        {
                            <table class="data-table" id="intakeTable">
                                <thead>
                                    <tr>
                                        <th>SlNo</th>
                                        <th>Course Level</th>
                                        <th>Course</th>
                                        <th>Intake</th>
                                        <th>Type</th>
                                        <th>RGUHS</th>
                                        <th>DCI</th>
                                        <th>KSDC</th>
                                        <th>GOK</th>
                                        <th>Actions</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var row in repositoryRows)
                                    {
                                        <tr data-id="@row.Id"
                                            data-intake="@row.IntakeDetails"
                                            data-type="@row.FreshOrIncrease"
                                            data-course="@row.Course"
                                            data-coursename="@row.CourseName">

                                            <!-- SlNo -->
                                            <td style="font-weight:700;color:var(--text-muted);">@row.Id</td>

                                            <!-- Course Level — always-visible disabled select; stays disabled (read-only) even in edit mode -->
                                            <td>
                                                <select class="course-select"
                                                        name="courseLevel"
                                                        data-current-code="@row.CourseLevel"
                                                        id="tblCourseLevel"
                                                        disabled
                                                        style="font-size:.78rem;border:1.5px solid var(--border);border-radius:6px;padding:.28rem .5rem;background:#f4f6fb;color:var(--text-main);font-family:'DM Sans',sans-serif;min-width:120px;cursor:default;max-width:160px;">
                                                    <option value="@row.CourseLevel" selected>@row.CourseLevel</option>
                                                </select>
                                                <!-- Hidden input carries the value on save since disabled selects are not submitted -->
                                                <input type="hidden" class="hidden-course-code" name="courseLevel" value="@row.CourseLevel" />
                                            </td>

                                            <!-- Course — always-visible disabled select; stays disabled (read-only) even in edit mode -->
                                            <td>
                                                <select class="course-select"
                                                        name="courseCode"
                                                        data-current-code="@row.Course"
                                                        id="tblCourseSelect"
                                                        disabled
                                                        style="font-size:.78rem;border:1.5px solid var(--border);border-radius:6px;padding:.28rem .5rem;background:#f4f6fb;color:var(--text-main);font-family:'DM Sans',sans-serif;min-width:120px;cursor:default;max-width:160px;">
                                                    <option value="@row.Course" selected>@row.CourseName</option>
                                                </select>
                                                <!-- Hidden input carries the value on save since disabled selects are not submitted -->
                                                <input type="hidden" class="hidden-course-code" name="courseCode" value="@row.Course" />
                                            </td>


                                            <!-- Intake — view / edit -->
                                            <td>
                                                <span class="view-mode fw-600">@row.IntakeDetails</span>
                                                <input class="edit-input edit-mode" name="intakeDetails"
                                                       value="@row.IntakeDetails" style="display:none;width:70px;" />
                                            </td>

                                            <!-- Type — view / edit -->
                                            <td>
                                                <span class="view-mode">
                                                    @if (row.FreshOrIncrease == "Fresh")
                                                    {
                                                        <span class="badge-fresh">@row.FreshOrIncrease</span>
                                                    }
                                                    else if (row.FreshOrIncrease == "Additional")
                                                    {

                                                        <span class="badge-additional">@row.FreshOrIncrease</span>
                                                    }
                                                    else
                                                    {

                                                        <span class="badge-increase">@row.FreshOrIncrease</span>
                                                    }
                                                </span>
                                                <select class="edit-select edit-mode" name="freshOrIncrease" style="display:none;">
                                                    <option value="Fresh" @(row.FreshOrIncrease == "Fresh" ? "selected" : "")>Fresh</option>
                                                    <option value="Increase" @(row.FreshOrIncrease == "Increase" ? "selected" : "")>Increase</option>
                                                    <option value="Additional" @(row.FreshOrIncrease == "Additional" ? "selected" : "")>Additional</option>
                                                </select>
                                            </td>

                                            
                                            <!-- RGUHS doc -->
                                            <td>
                                                <div class="view-mode">
                                                    @if (row.Rguhsnotification != null)
                                                    {
                                                        <a asp-action="DownloadDoc" asp-route-id="@row.Id" asp-route-type="RGUHS" class="doc-btn" target="_blank">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                    }
                                                    else
                                                    {

                                                        <span class="doc-btn-missing">—</span>
                                                    }
                                                </div>
                                                <div class="edit-mode" style="display:none;">
                                                    <label class="inline-upload-label">
                                                        <i class="bi bi-upload"></i> Replace
                                                        <input type="file" name="rghsFile" class="d-none inline-file-trigger" accept=".pdf,.jpg,.jpeg,.png" />
                                                    </label>
                                                    <span class="inline-file-name">@(row.Rguhsnotification != null ? "Current file saved" : "No file")</span>
                                                </div>
                                            </td>

                                            <!-- DCI doc (was INC) -->
                                            <td>
                                                <div class="view-mode">
                                                    @if (row.Inc != null)
                                                    {
                                                        <a asp-action="DownloadDoc" asp-route-id="@row.Id" asp-route-type="INC" class="doc-btn" target="_blank">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                    }
                                                    else
                                                    {

                                                        <span class="doc-btn-missing">—</span>
                                                    }
                                                </div>
                                                <div class="edit-mode" style="display:none;">
                                                    <label class="inline-upload-label">
                                                        <i class="bi bi-upload"></i> Replace
                                                        <input type="file" name="dciFile" class="d-none inline-file-trigger" accept=".pdf,.jpg,.jpeg,.png" />
                                                    </label>
                                                    <span class="inline-file-name">@(row.Inc != null ? "Current file saved" : "No file")</span>
                                                </div>
                                            </td>

                                            <!-- KSDC doc (was KNMC) -->
                                            <td>
                                                <div class="view-mode">
                                                    @if (row.Knmc != null)
                                                    {
                                                        <a asp-action="DownloadDoc" asp-route-id="@row.Id" asp-route-type="KNMC" class="doc-btn" target="_blank">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                    }
                                                    else
                                                    {

                                                        <span class="doc-btn-missing">—</span>
                                                    }
                                                </div>
                                                <div class="edit-mode" style="display:none;">
                                                    <label class="inline-upload-label">
                                                        <i class="bi bi-upload"></i> Replace
                                                        <input type="file" name="ksdcFile" class="d-none inline-file-trigger" accept=".pdf,.jpg,.jpeg,.png" />
                                                    </label>
                                                    <span class="inline-file-name">@(row.Knmc != null ? "Current file saved" : "No file")</span>
                                                </div>
                                            </td>

                                            <!-- GOK doc -->
                                            <td>
                                                <div class="view-mode">
                                                    @if (row.Gok != null)
                                                    {
                                                        <a asp-action="DownloadDoc" asp-route-id="@row.Id" asp-route-type="GOK" class="doc-btn" target="_blank">
                                                            <i class="bi bi-eye"></i> View
                                                        </a>
                                                    }
                                                    else
                                                    {

                                                        <span class="doc-btn-missing">—</span>
                                                    }
                                                </div>
                                                <div class="edit-mode" style="display:none;">
                                                    <label class="inline-upload-label">
                                                        <i class="bi bi-upload"></i> Replace
                                                        <input type="file" name="gokFile" class="d-none inline-file-trigger" accept=".pdf,.jpg,.jpeg,.png" />
                                                    </label>
                                                    <span class="inline-file-name">@(row.Gok != null ? "Current file saved" : "No file")</span>
                                                </div>
                                            </td>

                                            <!-- Actions -->
                                            <td>
                                                <div class="action-cell">
                                                    <div class="action-row-btns">
                                                        <button type="button" class="btn-edit btn-edit-row">
                                                            <i class="bi bi-pencil-square"></i>
                                                        </button>
                                                        <button type="button" class="btn-save-row">
                                                            <i class="bi bi-save"></i> Save
                                                        </button>
                                                    </div>
                                                    <div class="action-row-btns">
                                                        <button type="button" class="btn-cancel-row">
                                                            <i class="bi bi-x-circle"></i> Cancel
                                                        </button>
                                                        <button type="button" class="btn-delete delete-row" data-id="@row.Id">
                                                            <i class="bi bi-trash3"></i>
                                                        </button>
                                                    </div>
                                                </div>
                                            </td>

                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                    </div>
                </div>

            </div><!-- /main-grid -->
            <!-- NAV FOOTER -->
            <div class="nav-footer">
                <a asp-controller="Repo" asp-action="Repo_BasicDetails" class="btn-official-outline">
                    <i class="bi bi-arrow-left"></i> Previous
                </a>
                <span style="font-size:.75rem;color:var(--text-muted);">
                    <i class="bi bi-info-circle"></i> All fields marked are mandatory. Documents must be PDF/JPG.
                </span>
                <a asp-controller="Repo" asp-action="Repo_Affiliated_YearwiseMaterials" class="btn-official" style="text-decoration:none;">
                    Proceed to Next <i class="bi bi-arrow-right"></i>
                </a>
            </div>

        </main>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        $(document).ready(function () {

            /* ───────────────────────────────────────────
               1. Course by level (add form)
            ─────────────────────────────────────────── */
            $('#CourseLevel').change(function () {
                var selectedLevel = $(this).val();
                var $cd = $('#CourseDropdown');
                $cd.empty().append('<option value="">— Select —</option>');
                if (selectedLevel) {
                    $.get('@Url.Action("GetCoursesByLevel")', { level: selectedLevel }, function (response) {
                        if (response.success) {
                            $.each(response.data, function (i, course) {
                                $cd.append('<option value="' + course.courseCode + '">' + course.courseName + '</option>');
                            });
                        }
                    });
                }
            });
            $('#tblCourseLevel').change(function () {
                var selectedLevel = $(this).val();
                var $cd = $('#tblCourseSelect');
                $cd.empty().append('<option value="">— Select —</option>');
                if (selectedLevel) {
                    $.get('@Url.Action("GetCoursesByLevel")', { level: selectedLevel }, function (response) {
                        if (response.success) {
                            $.each(response.data, function (i, course) {
                                $cd.append('<option value="' + course.courseCode + '">' + course.courseName + '</option>');
                            });
                        }
                    });
                }
            });

            /* ───────────────────────────────────────────
               2. Auto Fresh / Increase (add form)
            ─────────────────────────────────────────── */
            $('#CourseDropdown').change(function () {
                var selectedText = $("#CourseDropdown option:selected").text();
                if (selectedText && selectedText !== "— Select Level First —" && selectedText !== "— Select —") {
                    $.get('@Url.Action("IsCourseFresh")', { courseName: selectedText }, function (result) {
                        $('#FreshOrIncrease').val(result.exists ? 'Increase' : 'Fresh');
                    });
                }
            });

            /* ───────────────────────────────────────────
               2b. Duplicate course+type guard on form submit
            ─────────────────────────────────────────── */
            $('form[action*="Repo_UGPG"]').on('submit', function (e) {
                var selectedCourseCode = $('#CourseDropdown').val();
                var selectedCourseName = $('#CourseDropdown option:selected').text().trim();
                var selectedType       = $('#FreshOrIncrease').val();

                if (!selectedCourseCode || !selectedType) return; // let server-side validation handle empties

                var duplicate = false;
                $('#intakeTable tbody tr').each(function () {
                    var rowCode = $(this).find('.course-select').data('current-code') + '';
                    var rowType = $(this).find('.view-mode .badge-fresh, .view-mode .badge-increase, .view-mode .badge-additional').text().trim();
                    if (rowCode === selectedCourseCode && rowType.toLowerCase() === selectedType.toLowerCase()) {
                        duplicate = true;
                        return false; // break
                    }
                });

                if (duplicate) {
                    e.preventDefault();
                    Swal.fire({
                        icon: 'warning',
                        title: 'Already Saved',
                        html: '<b>' + selectedCourseName + '</b> for <b style="color:#d97706;">' + selectedType + '</b> is already saved.<br>' +
                              '<span style="font-size:.85rem;color:#6b7a99;margin-top:6px;display:block;">Use the <b>Edit</b> button on the existing row to change the values.</span>',
                        confirmButtonColor: '#1d4ed8',
                        confirmButtonText: 'Got it',
                        customClass: { popup: 'swal-custom-popup', title: 'swal-custom-title' }
                    });
                }
            });

            /* ───────────────────────────────────────────
               3. Add-form file label update
            ─────────────────────────────────────────── */
            document.querySelectorAll(".hidden-file-input").forEach(function (input) {
                input.addEventListener("change", function () {
                    const lbl = this.closest(".upload-box").querySelector(".file-name");
                    const has = this.files && this.files.length > 0;
                    lbl.textContent = has ? this.files[0].name : "No file chosen";
                    lbl.classList.toggle("file-selected", has);
                    lbl.classList.toggle("file-not-selected", !has);
                });
            });

            /* ───────────────────────────────────────────
               4. Inline file trigger label update
            ─────────────────────────────────────────── */
            $(document).on('change', '.inline-file-trigger', function () {
                var $label = $(this).closest('label').siblings('.inline-file-name');
                if (this.files && this.files.length > 0) {
                    $label.text(this.files[0].name).addClass('chosen');
                } else {
                    $label.text('No file chosen').removeClass('chosen');
                }
            });

            /* ───────────────────────────────────────────
               5. EDIT button — enter edit mode
            ─────────────────────────────────────────── */
            $(document).on('click', '.btn-edit-row', function () {
                var $tr = $(this).closest('tr');

                // Exit any other row currently in edit mode
                $('.editing-row').each(function () {
                    exitEditMode($(this), false);
                });

                // Show edit controls
                $tr.find('.view-mode').hide();
                $tr.find('.edit-mode').show();
                $tr.addClass('editing-row');

                // Toggle buttons
                $(this).hide();
                $tr.find('.btn-save-row').css('display', 'inline-flex');
                $tr.find('.btn-cancel-row').css('display', 'inline-flex');
                $tr.find('.delete-row').hide();
            });

            /* ───────────────────────────────────────────
               6. CANCEL button — exit edit mode
            ─────────────────────────────────────────── */
            $(document).on('click', '.btn-cancel-row', function () {
                var $tr = $(this).closest('tr');
                exitEditMode($tr, false);
            });

            function exitEditMode($tr, saved) {
                $tr.find('.view-mode').show();
                $tr.find('.edit-mode').hide();
                $tr.removeClass('editing-row');
                $tr.find('.btn-edit-row').show();
                $tr.find('.btn-save-row').hide();
                $tr.find('.btn-cancel-row').hide();
                $tr.find('.delete-row').show();

                // Reset file input labels if not saved
                if (!saved) {
                    $tr.find('.inline-file-trigger').val('');
                    $tr.find('.inline-file-name').each(function () {
                        var original = $(this).data('original') || $(this).text();
                        $(this).text(original).removeClass('chosen');
                    });
                }
            }

            /* ───────────────────────────────────────────
               7. SAVE button — AJAX multipart submit
            ─────────────────────────────────────────── */
            $(document).on('click', '.btn-save-row', function () {
                var $tr = $(this).closest('tr');
                var id  = $tr.data('id');

                // Build FormData from the row
                var fd = new FormData();
                fd.append('id',              id);
                fd.append('intakeDetails',   $tr.find('input[name="intakeDetails"]').val());
                fd.append('freshOrIncrease', $tr.find('select[name="freshOrIncrease"]').val());
                fd.append('courseCode',      $tr.find('.hidden-course-code').val()); // disabled select not submitted, use hidden input

                // Files — only append if a new file was chosen
                appendFileIfChosen(fd, $tr, 'rghsFile');
                appendFileIfChosen(fd, $tr, 'dciFile');
                appendFileIfChosen(fd, $tr, 'ksdcFile');
                appendFileIfChosen(fd, $tr, 'gokFile');

                // CSRF token
                fd.append('__RequestVerificationToken', $('input[name="__RequestVerificationToken"]').val());

                $tr.addClass('row-saving');

                $.ajax({
                    url: '@Url.Action("EditFacultyIntake", "Repo")',
                    type: 'POST',
                    data: fd,
                    processData: false,
                    contentType: false,
                    success: function (result) {
                        $tr.removeClass('row-saving');
                        if (result.success) {
                            // Update visible view-mode cells
                            var newIntake = $tr.find('input[name="intakeDetails"]').val();
                            var newType   = $tr.find('select[name="freshOrIncrease"]').val();

                            $tr.find('td:nth-child(2) .view-mode').text(newIntake);

                            var badgeHtml = newType === 'Fresh'
                                ? '<span class="badge-fresh">' + newType + '</span>'
                                : newType === 'Additional'
                                    ? '<span class="badge-additional">' + newType + '</span>'
                                    : '<span class="badge-increase">' + newType + '</span>';
                            $tr.find('td:nth-child(3) .view-mode').html(badgeHtml);

                            exitEditMode($tr, true);

                            // Brief success flash
                            $tr.css('background', '#f0fdf4');
                            setTimeout(function () { $tr.css('background', ''); }, 1200);
                        } else {
                            alert(result.message || 'Save failed. Please try again.');
                        }
                    },
                    error: function () {
                        $tr.removeClass('row-saving');
                        alert('Network error. Please check your connection and try again.');
                    }
                });
            });

            function appendFileIfChosen(fd, $tr, fieldName) {
                var input = $tr.find('input[name="' + fieldName + '"]')[0];
                if (input && input.files && input.files.length > 0) {
                    fd.append(fieldName, input.files[0]);
                }
            }

            /* ───────────────────────────────────────────
               8. DELETE button — SweetAlert2 confirmation
            ─────────────────────────────────────────── */
            $(document).on('click', '.delete-row', function () {
                var $btn  = $(this);
                var id    = $btn.data('id');
                var $tr   = $btn.closest('tr');
                var course = $tr.find('.course-select option:selected').text().trim() || ('Record #' + id);
                var type   = $tr.find('select[name="freshOrIncrease"] option:selected').text().trim()
                             || $tr.find('.view-mode .badge-fresh, .view-mode .badge-increase, .view-mode .badge-additional').text().trim()
                             || '';

                Swal.fire({
                    title: 'Delete this record?',
                    html:  '<b>' + course + '</b>' + (type ? ' &mdash; <span style="color:#d97706;">' + type + '</span>' : '') +
                           '<br><span style="font-size:.85rem;color:#6b7a99;margin-top:6px;display:block;">This action cannot be undone.</span>',
                    icon:  'warning',
                    showCancelButton:  true,
                    confirmButtonColor: '#dc2626',
                    cancelButtonColor:  '#6b7a99',
                    confirmButtonText:  '<i class="bi bi-trash3"></i>&nbsp; Yes, Delete',
                    cancelButtonText:   'Cancel',
                    reverseButtons: true,
                    customClass: {
                        popup:         'swal-custom-popup',
                        title:         'swal-custom-title',
                        confirmButton: 'swal-confirm-btn',
                        cancelButton:  'swal-cancel-btn'
                    }
                }).then(function (result) {
                    if (!result.isConfirmed) return;

                    $.ajax({
                        url:  '@Url.Action("DeleteFacultyIntake")',
                        type: 'POST',
                        data: { id: id, __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val() },
                        success: function (res) {
                            if (res.success) {
                                $tr.fadeOut(350, function () { $(this).remove(); });
                                Swal.fire({
                                    toast: true,
                                    position: 'top-end',
                                    icon: 'success',
                                    title: 'Record deleted successfully',
                                    showConfirmButton: false,
                                    timer: 2500,
                                    timerProgressBar: true
                                });
                            } else {
                                Swal.fire('Error', res.message || 'Delete failed. Please try again.', 'error');
                            }
                        },
                        error: function () {
                            Swal.fire('Network Error', 'Request failed. Please check your connection.', 'error');
                        }
                    });
                });
            });

        });
    </script>

</body>
</html>
